{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "homeassistant-justnimbus",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/justnimbus_mqtt/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    }
  }
}
